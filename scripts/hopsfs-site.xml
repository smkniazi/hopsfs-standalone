<!-- Put site-specific property overrides in this file. -->

<configuration>

<!-- *************  Create Test Data ************* -->

<property>
   <name>create.test.data</name>
   <value>true</value>
</property>

<!-- *************  Cloud Storage ************* -->
<!-- ***** NOTE. For minio there is *********** -->
<!-- ***** AWS_ACCESS_KEY_ID  and ************* -->
<!-- ***** AWS_SECRET_ACCESS_KEY set in the *** -->
<!-- ***** run script. unset that if you want * -->
<!-- ***** to user AWS ************************ -->

<property>
   <name>dfs.enable.cloud.persistence</name>
   <value>true</value>
</property>

<property>
   <name>dfs.cloud.provider</name>
   <value>AWS</value>
   <description>Cloud provider. Currently only AWS is supported</description>
</property>

<property>
   <name>dfs.cloud.aws.s3.bucket</name>
   <value>hopsfsstandalonecluster</value>
   <description>Hopsfs S3 bucket used to store file system blocks</description>
</property>

<property>
   <name>dfs.cloud.aws.s3.region</name>
   <value>eu-north-1</value>
   <description>Bucket region</description>
</property>

<!-- <property> -->
   <!-- <name>dfs.cloud.aws.endpoint</name> -->
   <!-- <value>http://localhost:9000</value> -->
   <!-- <description>Endpoint. Needed for minio</description> -->
<!-- </property> -->

<property>
   <name>dfs.cloud.store.small.files.in.db</name>
   <value>false</value>
   <description>Do not store small files in the DB</description>
</property>

<!-- *************  Async Cloud Upload (HOPSFS-345) ************* -->
<!-- Master switch for the async cloud upload write-back cache.    -->
<!-- When true, finalized blocks land on local disk and a worker   -->
<!-- pool uploads them to cloud in the background. Must match on   -->
<!-- NameNode and DataNode. Set false for the original sync-only   -->
<!-- behavior.                                                     -->

<property>
   <name>dfs.cloud.async.upload.enabled</name>
   <value>true</value>
   <description>Enable async cloud upload. Must match on NN and DN.</description>
</property>

<property>
   <name>dfs.cloud.dn.async.upload.threads</name>
   <value>4</value>
   <description>Async-upload worker pool size. Distinct from
   dfs.dn.cloud.max.upload.threads (which is the cloud SDK's HTTP
   transfer pool).</description>
</property>

<property>
   <name>dfs.cloud.dn.async.upload.queue.capacity</name>
   <value>1000</value>
   <description>Bounded async-upload queue size; overflow triggers
   sync fallback.</description>
</property>

<property>
   <name>dfs.cloud.dn.async.upload.retry.count</name>
   <value>3</value>
   <description>Retry attempts before re-enqueueing a failed upload
   at the queue tail.</description>
</property>

<property>
   <name>dfs.cloud.dn.async.upload.retry.interval.ms</name>
   <value>30000</value>
   <description>Base backoff between retries in milliseconds
   (exponential, capped at 5 minutes).</description>
</property>

