<!-- Put site-specific property overrides in this file. -->

<configuration>

<!-- *************  Create Test Data ************* -->

<property>
   <name>create.test.data</name>
   <value>true</value>
</property>

<!-- *************  Cloud Storage ************* -->
<!-- ***** NOTE. For minio there is *********** -->
<!-- ***** AWS_ACCESS_KEY_ID  and ************* -->
<!-- ***** AWS_SECRET_ACCESS_KEY set in the *** -->
<!-- ***** run script. unset that if you want * -->
<!-- ***** to user AWS ************************ -->

<property>
   <name>dfs.enable.cloud.persistence</name>
   <value>true</value>
</property>

<property>
   <name>dfs.cloud.provider</name>
   <value>AWS</value>
   <description>Cloud provider. Currently only AWS is supported</description>
</property>

<property>
   <name>dfs.cloud.aws.s3.bucket</name>
   <value>hopsfsstandalonecluster</value>
   <description>Hopsfs S3 bucket used to store file system blocks</description>
</property>

<property>
   <name>dfs.cloud.aws.s3.region</name>
   <value>eu-north-1</value>
   <description>Bucket region</description>
</property>

<property>
   <name>dfs.cloud.aws.endpoint</name>
   <value>http://localhost:9000</value>
   <description>Endpoint. Needed for minio</description>
</property>

<property>
   <name>dfs.cloud.store.small.files.in.db</name>
   <value>false</value>
   <description>Do not store small files in the DB</description>
</property>

<!-- *************  SSL ************* -->
<!-- <property> -->
   <!-- <name>ipc.server.ssl.enabled</name> -->
   <!-- <value>true</value> -->
   <!-- <description>Enable/Disable SSL</description> -->
<!-- </property> -->

<!-- *************  KMS ************* -->
<!-- <property> -->
   <!-- <name>enable.kms</name> -->
   <!-- <value>true</value> -->
   <!-- <description>Enable/Disable KMS</description> -->
<!-- </property> -->

<!-- ************* Audit ************* -->
<property>
   <name>dfs.namenode.audit.log.stat.operation</name>
   <value>false</value>
   <description>Disable audit logging for stat (getFileInfo) operations (matches production default)</description>
</property>

<!-- ************* Other ************* -->
<property>
   <name>dfs.blocksize</name>
   <value>134217728</value>
   <description>1048576 is 1 MB. 134217728 is 128 MB</description>
</property>
<property>
   <name>dfs.namenode.file.close.num-committed-allowed</name>
   <value>1</value>
   <description></description>
</property>
<property> 
   <name>fs.permissions.umask-mode</name>
   <value>0007</value>
   <description></description>
</property>

<!-- *** Additional User and Group ** -->
<property>
   <name>hopsfs.additional.user</name>
   <value>testuser</value>
   <description></description>
</property>
<property>
   <name>hopsfs.additional.group</name>
   <value>testuser</value>
   <description></description>
</property>


<property>
   <name>dfs.namenode.enable.retrycache</name>
   <value>true</value>
   <description></description>
</property>
</configuration>